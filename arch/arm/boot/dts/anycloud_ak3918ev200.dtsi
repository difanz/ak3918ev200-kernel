
#include "anycloud_ak39ev330_common.dtsi"

#define RESERVED_MEMORY_BASE  0x80000000
#define RESERVED_MEMORY_SIZE  0x1800000

/ {
    model = "anyka,ak3918ev200";
    compatible = "anyka,ak3918ev200";

	chosen {
		bootargs = "console=ttySAK0,115200n8 root=/dev/mtdblock5 rootfstype=squashfs init=/sbin/init mem=64M memsize=64M";
	};

	cpus {
	    #address-cells = <1>;
	    #size-cells = <0>;

	    cpu@0 {
	        compatible = "arm, arm926ej-s";
	        device_type = "cpu";
	        reg = <0>;
	        d-cache-line-size = <32>;
	        i-cache-line-size = <32>;
	        d-cache-size = <0x8000>;
	        i-cache-size = <0x8000>;
	        timebase-frequency = <0>;
	        bus-frequency = <0>;
	        clock-frequency = <0>;
	    };
	};

    memory {
	    device_type = "memory";
	    reg = <0x80000000 0x04000000>;
	};

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        dma_reserved: dma_reserved@RESERVED_MEMORY_BASE {
            size = <RESERVED_MEMORY_SIZE>;
            reg = <RESERVED_MEMORY_BASE RESERVED_MEMORY_SIZE>;
            status = "okay";
        };
    };

    ion {
        compatible = "anyka,ak3918ev200-ion-reserve";
        memory-region = <&dma_reserved>;
        #address-cells = <1>;
        #size-cells = <1>;
        heaps-nr = <1>;
        ranges;

        dma_reserved_heap: dma_reserved_heap {
            compatible = "anyka,dma-reserve";
            ion-id = <1>;
            ion-type = <1>;
            base-address = <RESERVED_MEMORY_BASE>;
            size = <RESERVED_MEMORY_SIZE>;
            align = <0x4>;
            status = "okay";
        };
    };
};

&core_pll {
    clock-div-od = <1>;
    clock-frequency = <400000000>;
};

&gpio {
    compatible = "anyka,ak3918ev200-gpio";
};
